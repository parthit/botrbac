# Copy to .env for local development (.env is git-ignored). Never commit real values.
# Run locally with:  uv run --env-file .env uvicorn api.index:app --reload --port 8000
# On Vercel, set the same names in Project Settings -> Environment Variables.
# Full list and explanations: docs/self-hosting.md

# ---- required -----------------------------------------------------------------

# Google Cloud -> Credentials -> OAuth client ID of type "Web application".
# Authorized redirect URI: <APP_BASE_URL>/auth/callback (locally http://localhost:8000/auth/callback).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Your Google address. The admin, and the only account that can open /admin.
OWNER_EMAIL=

# Public origin, no trailing slash. Locally: http://localhost:8000
APP_BASE_URL=http://localhost:8000
# Optional: who visitors can write to. Shown on the home page and in the footer.
# CONTACT_EMAIL=

# Generate both with: uv run python scripts/make_secrets.py
SESSION_SECRET=
ENCRYPTION_KEY=

# Google's file picker: how people add files (Bot RBAC only gets files they pick).
# API key restricted to the Google Picker API and to your site (and http://localhost:8000/*).
GOOGLE_PICKER_API_KEY=
# Console home -> Project info -> Project number (digits, not the project id).
GOOGLE_CLOUD_PROJECT_NUMBER=

# Storage. Required on Vercel (Upstash Redis via the Vercel Marketplace adds KV_REST_API_URL /
# KV_REST_API_TOKEN; either pair works). Leave empty locally to use an in-memory store
# that is wiped on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or Postgres instead of Redis:
# DATABASE_URL=postgresql://...

# ---- recommended --------------------------------------------------------------

# Comma-separated addresses allowed to sign in. Empty: any Google account Google lets through.
# OWNER_EMAIL is always allowed.
ALLOWED_EMAILS=

# ---- optional -----------------------------------------------------------------

# Static bearer tokens for the admin (xAI API, scripts, MCP Inspector). Assistants that use
# OAuth (Claude, ChatGPT, Grok, Cursor, Muse) do not need these.
# Comma-separated name:role:sha256hex entries. Roles: viewer, editor, admin.
# Generate with: uv run python scripts/make_token.py my-script viewer
API_TOKENS=

# A folder that is always allowed for the admin, on top of what is ticked in the dashboard.
# ROOT_FOLDER_ID=

# Limits (defaults shown).
# MAX_BYTES=5242880
# MAX_CHARS=100000
# Hours a file a paired person sent is held for its recipient to save to Drive.
# DROP_HOLD_HOURS=24
# Largest file a person may send from the dashboard, in MB (sent in 4 MB pieces).
# DROP_MAX_MB=20
# Held files go to Vercel Blob when a (private) Blob store is connected: Vercel adds
# BLOB_READ_WRITE_TOKEN. These keep them inside the free tier (2,000 uploads, 1 GB).
# DROP_BLOB_MONTHLY_UPLOADS=1500
# DROP_BLOB_STORAGE_MB=800
# On Vercel, with a Blob store and ENCRYPTION_KEY, browsers send and fetch held files straight
# to and from Blob, encrypted in the browser with a key per file, through URLs the Node
# function api/blob-sign.mjs signs. Nothing to set. Where the signer answers: production calls
# APP_BASE_URL, other deployments their own VERCEL_URL. BLOB_SIGNER_URL overrides that; "off"
# sends every file through the app instead.
# BLOB_SIGNER_URL=off
# Vercel sets VERCEL_AUTOMATION_BYPASS_SECRET when "Protection Bypass for Automation" is on; the
# app sends it to the signer on protected deployment URLs. Never put it here by hand.
# Read PDF and Office files in a separate, memory-limited process (0 = in the server process).
# EXTRACT_ISOLATION=1
# EXTRACT_MEMORY_MB=768
# SCOPE_CACHE_TTL=60
# ALLOWLIST_CACHE_TTL=2

# Notion (optional). Create a public OAuth connection in Notion's developer tools with the
# redirect URI <APP_BASE_URL>/connect/notion/callback and only "Read content". Notion shows
# up on Settings only when both are set. See docs/notion.md.
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# Off by default: Notion is read-only. Set to 1 to let assistants that may edit create new
# pages under allowed Notion pages (also needs "Insert content" on the connection in Notion).
# NOTION_ALLOW_CREATE=0

# OneDrive (optional). Register an app in Microsoft Entra (any organization and personal
# accounts) with the Web redirect URI <APP_BASE_URL>/connect/onedrive/callback and only the
# delegated Graph permissions Files.ReadWrite, User.Read and offline_access (keep Files.Read
# if it is already there). OneDrive shows up on Settings only when both are set. See
# docs/onedrive.md.
# ONEDRIVE_OAUTH_CLIENT_ID=
# ONEDRIVE_OAUTH_CLIENT_SECRET=
# Wake paired assistants when mail arrives. On when WEBHOOK_KEK is set.
# WEBHOOK_KEK=  (output of: openssl rand -base64 32)
# WEBHOOK_HOST_ALLOWLIST=api2.cursor.sh,api.anthropic.com

# Daily clean-up (vercel.json `crons` calls /internal/sweep). Set CRON_SECRET in Vercel to a
# random string of 16+ characters; Vercel sends it with the cron request. Without it the route
# does not exist and clean-up only happens as a side effect of ordinary requests.
# CRON_SECRET=  (output of: openssl rand -hex 32)

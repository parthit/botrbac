{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "src/scoped_drive_mcp/templates/**",
      "excludeFiles": "{tests/**,docs/**,scripts/**,.venv/**,**/__pycache__/**,node_modules/**}"
    },
    "api/blob-sign.mjs": {
      "maxDuration": 10
    }
  },
  "crons": [
    { "path": "/internal/sweep", "schedule": "17 4 * * *" }
  ],
  "rewrites": [
    { "source": "/((?!api/blob-sign).*)", "destination": "/api/index" }
  ]
}
